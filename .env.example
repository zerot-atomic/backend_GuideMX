# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/mxguide?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-16-chars
JWT_EXPIRES_IN=7d

# Server
PORT=3000

# Cloudinary (opcional - para subida de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Email (para recuperación de contraseña)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-email@gmail.com
MAIL_PASS=tu-app-password-gmail
MAIL_FROM="MXGuide <no-reply@mxguide.app>"