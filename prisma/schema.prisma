generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client_extensions {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  user
  admin
}

model State {
  id     String  @id @default(uuid())
  name   String  @unique
  places Place[]
}

model Category {
  id     String          @id @default(uuid())
  name   String          @unique
  icon   String
  places PlaceCategory[]
}

model Place {
  id               String           @id @default(uuid())
  name             String
  shortDescription String
  longDescription  String
  // Coordenadas PostGIS (lat/lng). Prisma no modela Geography de forma nativa,
  // por eso se gestiona con $queryRaw / $executeRaw (ver places.service.ts).
  latitude         Float
  longitude        Float
  address          String
  stateId          String
  state            State            @relation(fields: [stateId], references: [id])
  municipality     String
  openingHours     String?
  entryCost        Decimal?
  relevanceScore   Int              @default(0)
  isPublished      Boolean          @default(false)
  images           PlaceImage[]
  categories       PlaceCategory[]
  favorites        Favorite[]
  reviews          Review[]
  visits           Visit[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  PlaceThumbnail   PlaceThumbnail[]
}

model PlaceCategory {
  placeId    String
  categoryId String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
}

model PlaceImage {
  id      String @id @default(uuid())
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)
}

model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  passwordHash          String?
  googleId              String?  @unique
  name                  String
  role                  Role       @default(user)
  favorites             Favorite[]
  reviews               Review[]
  visits                Visit[]
  passwordResetTokens   PasswordResetToken[]
  passwordResetAudits   PasswordResetAudit[]
  createdAt             DateTime   @default(now())
}

model Favorite {
  id      String @id @default(uuid())
  userId  String
  placeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PlaceThumbnail {
  placeId   String   @id
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  mime      String
  data      String   @db.Text // miniatura codificada en Base32
  updatedAt DateTime @updatedAt
}

// Lugares que el usuario ha visitado (alimenta las insignias por estado del front).
// El estado se obtiene del lugar (Place.stateId), por eso no se guarda aquí.
model Visit {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  visitedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
}

// Tokens de recuperación de contraseña (un solo uso, expiración corta)
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits    PasswordResetAudit[]

  @@index([userId])
  @@index([expiresAt])
}

// Auditoría completa de cada intento de recuperación
// action: REQUESTED | VERIFIED | USED | EXPIRED | INVALID
model PasswordResetAudit {
  id        String   @id @default(uuid())
  userId    String?
  tokenId   String?
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     PasswordResetToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
